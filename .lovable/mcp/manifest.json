{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ceskhsmgnazliclfwxqs.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "biblioteca-de-referencias",
      "version": "0.2.0",
      "title": "Biblioteca de Referências"
    },
    "tools": [
      {
        "name": "search_sources",
        "title": "Buscar referências",
        "description": "Busca referências da biblioteca do usuário por texto (título, revista, DOI), tipo, ano ou status de leitura.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Texto livre buscado em título, revista/editora e DOI."
            },
            "source_type": {
              "type": "string",
              "description": "Tipo da fonte, ex.: article, book, thesis."
            },
            "status_reading": {
              "type": "string",
              "description": "Status de leitura, ex.: to_read, reading, read."
            },
            "year": {
              "type": "integer",
              "description": "Ano de publicação exato."
            },
            "favorites_only": {
              "type": "boolean",
              "description": "Retornar apenas favoritas."
            },
            "limit": {
              "type": "integer",
              "description": "Máximo de resultados (padrão 20, teto 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_sources_by_person",
        "title": "Buscar referências por autor",
        "description": "Lista as referências associadas a uma pessoa (autor, orientador etc.), buscando pelo nome parcial ou completo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Nome (ou parte do nome) da pessoa."
            },
            "role": {
              "type": [
                "string",
                "null"
              ],
              "description": "Filtra pelo papel, ex.: autor, orientador."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de resultados (padrão 50, teto 200)."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_sources_by_term",
        "title": "Buscar referências por palavra-chave ou tag",
        "description": "Lista as referências associadas a uma palavra-chave ou a uma tag do usuário. Use list_terms antes para descobrir os termos existentes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "term": {
              "type": "string",
              "minLength": 1,
              "description": "Palavra-chave ou tag (busca por texto parcial)."
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "keyword",
                    "tag",
                    "both"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Onde buscar: keyword, tag ou both (padrão both)."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de resultados (padrão 50, teto 200)."
            }
          },
          "required": [
            "term"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_terms",
        "title": "Listar palavras-chave e tags",
        "description": "Lista as palavras-chave e as tags existentes na biblioteca do usuário, para depois filtrar referências por elas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": [
                "string",
                "null"
              ],
              "description": "Filtra por texto parcial no termo."
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "keyword",
                    "tag",
                    "both"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "O que listar: keyword, tag ou both (padrão both)."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de itens por tipo (padrão 100, teto 500)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_source",
        "title": "Ver referência",
        "description": "Retorna todos os dados de uma referência, incluindo autores, palavras-chave, tags e citação ABNT.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID (uuid) da referência."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_source",
        "title": "Adicionar referência",
        "description": "Cria uma nova referência na biblioteca do usuário. Use apenas os campos conhecidos; os demais podem ser preenchidos depois no app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Título da fonte."
            },
            "source_type": {
              "type": "string",
              "description": "Tipo da fonte (padrão: article). Ex.: article, book, thesis, website."
            },
            "year": {
              "type": "integer",
              "description": "Ano de publicação."
            },
            "container_title": {
              "type": "string",
              "description": "Revista, livro ou evento onde foi publicado."
            },
            "publisher": {
              "type": "string",
              "description": "Editora ou instituição."
            },
            "doi": {
              "type": "string",
              "description": "DOI da publicação."
            },
            "url": {
              "type": "string",
              "description": "URL de acesso."
            },
            "abstract": {
              "type": "string",
              "description": "Resumo da fonte."
            },
            "personal_notes": {
              "type": "string",
              "description": "Notas pessoais sobre a fonte."
            },
            "status_reading": {
              "type": "string",
              "description": "Status de leitura (padrão: to_read)."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_source",
        "title": "Atualizar referência",
        "description": "Atualiza campos de uma referência existente. Apenas os campos informados são alterados.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID (uuid) da referência."
            },
            "title": {
              "type": "string",
              "description": "Novo título."
            },
            "source_type": {
              "type": "string",
              "description": "Novo tipo da fonte."
            },
            "year": {
              "type": "integer",
              "description": "Novo ano de publicação."
            },
            "container_title": {
              "type": "string",
              "description": "Nova revista/livro/evento."
            },
            "publisher": {
              "type": "string",
              "description": "Nova editora."
            },
            "doi": {
              "type": "string",
              "description": "Novo DOI."
            },
            "url": {
              "type": "string",
              "description": "Nova URL."
            },
            "abstract": {
              "type": "string",
              "description": "Novo resumo."
            },
            "personal_notes": {
              "type": "string",
              "description": "Novas notas pessoais."
            },
            "status_reading": {
              "type": "string",
              "description": "Novo status de leitura."
            },
            "is_favorite": {
              "type": "boolean",
              "description": "Marcar ou desmarcar como favorita."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_source",
        "title": "Excluir referência",
        "description": "Exclui permanentemente uma referência da biblioteca do usuário, junto com seus vínculos de autores, palavras-chave, tags e projetos. Ação destrutiva: confirme com o usuário antes de executar.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "description": "ID (uuid) da referência a excluir."
            }
          },
          "required": [
            "source_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "cite_sources",
        "title": "Gerar citações em lote",
        "description": "Devolve as citações ABNT (completa, integrada e parentética) já salvas para uma lista de referências, ou para todas as referências de um projeto.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "source_ids": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "IDs (uuid) das referências. Ignorado quando project_id é informado."
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "ID (uuid) de um projeto: cita todas as referências vinculadas a ele."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "Listar projetos",
        "description": "Lista os projetos (coleções de referências) do usuário, com a quantidade de referências em cada um.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Filtra projetos pelo nome."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_project",
        "title": "Criar projeto",
        "description": "Cria um novo projeto (coleção de referências) para o usuário.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Nome do projeto."
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Descrição opcional do projeto."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_project_sources",
        "title": "Ver referências de um projeto",
        "description": "Lista as referências que pertencem a um projeto (coleção) do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "description": "ID (uuid) do projeto."
            },
            "limit": {
              "type": "integer",
              "description": "Máximo de referências (padrão 50, teto 200)."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_source_to_project",
        "title": "Adicionar referência a um projeto",
        "description": "Vincula uma referência existente a um projeto (coleção) do usuário.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "description": "ID (uuid) do projeto."
            },
            "source_id": {
              "type": "string",
              "description": "ID (uuid) da referência."
            }
          },
          "required": [
            "project_id",
            "source_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "remove_source_from_project",
        "title": "Remover referência de um projeto",
        "description": "Desvincula uma referência de um projeto (coleção). A referência continua existindo na biblioteca.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "description": "ID (uuid) do projeto."
            },
            "source_id": {
              "type": "string",
              "description": "ID (uuid) da referência."
            }
          },
          "required": [
            "project_id",
            "source_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
